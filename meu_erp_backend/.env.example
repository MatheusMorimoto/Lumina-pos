ERP_APP_NAME=Sistema Integrado de Gestão Comercial
ERP_ENVIRONMENT=development
ERP_DEBUG=false
ERP_CORS_ORIGINS=http://localhost:3000
ERP_SUPABASE_URL=https://seu-projeto.supabase.co
ERP_SUPABASE_KEY=sua-chave-anon-ou-service-role
ERP_SUPABASE_ANON_KEY=sua-chave-publica-anon
ERP_SUPABASE_SECRET_KEY=sua-chave-secreta-apenas-no-backend
# Compatibilidade com projetos Supabase antigos (use apenas uma chave administrativa):
# ERP_SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
ERP_DATABASE_URL=postgresql://usuario:senha@host:5432/banco
ERP_SUPABASE_TIMEOUT_SECONDS=10
ERP_SUPABASE_EXPECTED_PROJECT_ID=gfqrqlvkqqnhzwbcozzp
ERP_JWT_SECRET_KEY=gere-uma-chave-segura
ERP_JWT_ALGORITHM=HS256
ERP_ACCESS_TOKEN_EXPIRE_MINUTES=60
ERP_PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/redefinir-senha
ERP_LEGACY_PASSWORD_LOGIN_ENABLED=false

# Diagnostico temporario: mantenha desabilitado fora da janela de validacao.
ERP_DIAGNOSTIC_ENABLED=false
ERP_DIAGNOSTIC_USERNAME=administrador
ERP_DIAGNOSTIC_PASSWORD=gere-uma-senha-temporaria-forte
ERP_LOGIN_RATE_LIMIT_ATTEMPTS=5
ERP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
